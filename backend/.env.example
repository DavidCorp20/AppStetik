# Stetik backend environment template
# NEVER commit real credentials here.
MONGO_URL=mongodb+srv://<db_user>:<db_password>@<cluster>/<database>?retryWrites=true&w=majority
DB_NAME=stetik_pro
JWT_SECRET=<generate-a-random-secret-of-at-least-64-characters>
CORS_ORIGINS=https://your-domain.example

# Production hardening flags
STETIK_ALLOW_UNSUBSCRIBED_ACCESS=false
STETIK_ALLOW_LEGACY_UPGRADE=false
STETIK_ALLOW_DEBUG_ENDPOINTS=false
